---
// Requests go through the proxy to account A until it hits its limit, then fail over to account B.
---

<figure class="guide-figure proxy-failover">
	<svg viewBox="0 0 640 300" role="img" aria-label="Claude Code and Codex send requests through CLI Proxy, which switches to a second account when the first one hits its limit">
		<path class="link" id="pf-t1" d="M158 110 C 205 110, 215 150, 262 150" />
		<path class="link" id="pf-t2" d="M158 190 C 205 190, 215 150, 262 150" />
		<path class="link" id="pf-a" d="M378 150 C 420 150, 430 90, 470 90" />
		<path class="link" id="pf-b" d="M378 150 C 420 150, 430 210, 470 210" />

		<g class="device" transform="translate(95 110)">
			<rect x="-52" y="-22" width="112" height="44" rx="6" />
			<path d="M-38 -6 l8 6 l-8 6 M-24 6 H-12" />
			<text class="node-label" x="2" y="5" style="text-anchor:start">Claude</text>
		</g>
		<g class="device" transform="translate(95 190)">
			<rect x="-52" y="-22" width="112" height="44" rx="6" />
			<path d="M-38 -6 l8 6 l-8 6 M-24 6 H-12" />
			<text class="node-label" x="2" y="5" style="text-anchor:start">Codex</text>
		</g>
		<text class="node-sub" x="95" y="250">your tools</text>

		<g class="device device-vps" transform="translate(320 150)">
			<circle class="halo" r="62" />
			<rect x="-46" y="-30" width="92" height="60" rx="14" />
			<path d="M-24 -10 H-4 C 6 -10, 6 10, 16 10 H24 M-24 10 H-4 C 6 10, 6 -10, 16 -10 H24" />
			<text class="node-label" y="58">CLI Proxy</text>
			<text class="node-sub" y="76">one endpoint</text>
		</g>

		<g class="account account-a" transform="translate(540 90)">
			<g class="device">
				<rect x="-70" y="-34" width="140" height="68" rx="10" />
			</g>
			<text class="node-label" y="-8">Account A</text>
			<rect class="quota-track" x="-50" y="4" width="100" height="6" rx="3" />
			<rect class="quota-fill" x="-50" y="4" width="20" height="6" rx="3" />
			<text class="node-sub status" y="26">in use</text>
		</g>
		<g class="account account-b" transform="translate(540 210)">
			<g class="device">
				<rect x="-70" y="-34" width="140" height="68" rx="10" />
			</g>
			<text class="node-label" y="-8">Account B</text>
			<rect class="quota-track" x="-50" y="4" width="100" height="6" rx="3" />
			<rect class="quota-fill" x="-50" y="4" width="12" height="6" rx="3" />
			<text class="node-sub status" y="26">standby</text>
		</g>

		<circle class="packet" r="5" />
	</svg>
	<figcaption>When Account A hits its limit, the proxy cools it down and sends the next request to Account B. Your tools never notice.</figcaption>
</figure>

<script>
	import { createTimeline, svg } from 'animejs';

	if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
		document.querySelectorAll<SVGSVGElement>('.proxy-failover svg').forEach((el) => {
			const $ = <T extends Element = SVGElement>(s: string) => el.querySelector<T>(s)!;
			const packet = $('.packet');
			const path = (id: string) => svg.createMotionPath($<SVGPathElement>(id));
			const status = (acct: string, text: string) => () => ($(`.account-${acct} .status`).textContent = text);
			const tl = createTimeline({ loop: true, loopDelay: 800, defaults: { ease: 'inOutSine' } });

			const send = (from: string, to: 'a' | 'b', width: number) =>
				tl
					.add(packet, { ...path(from), opacity: [0, 1], duration: 650 })
					.add($('.halo'), { scale: [1, 1.1, 1], duration: 400 })
					.add(packet, { ...path(`#pf-${to}`), opacity: [1, 0], duration: 650 })
					.add($(`.account-${to} .quota-fill`), { width, duration: 350 });

			send('#pf-t1', 'a', 50);
			send('#pf-t2', 'a', 78);
			send('#pf-t1', 'a', 100);
			tl.add($('.account-a'), { opacity: [1, 0.4], duration: 350, onBegin: status('a', 'limit hit, cooling down') })
				.add($('.account-b .status'), { opacity: [0, 1], duration: 300, onBegin: status('b', 'in use') });
			send('#pf-t2', 'b', 30);
			send('#pf-t1', 'b', 48);
			tl.add([$('.account-a .quota-fill'), $('.account-b .quota-fill')], {
				width: (_: unknown, i: number) => (i ? 12 : 20),
				duration: 500,
				delay: 900,
				onComplete: () => {
					status('a', 'in use')();
					status('b', 'standby')();
				},
			}).add($('.account-a'), { opacity: 1, duration: 300 }, '<<');
		});
	}
</script>

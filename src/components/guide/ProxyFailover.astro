---
// Requests go through the proxy to account A until it hits its limit, then fail over to account B.
---

<figure class="guide-figure proxy-failover">
	<svg viewBox="0 0 640 280" role="img" aria-label="Requests from Claude Code and Codex go through CLI Proxy, which switches to a second account when the first one hits its limit">
		<g class="node" transform="translate(80 140)">
			<rect x="-66" y="-46" width="132" height="92" rx="12" />
			<text class="node-label" y="-12">Claude Code</text>
			<text class="node-label" y="10">Codex</text>
			<text class="node-sub" y="32">laptop + VPS</text>
		</g>
		<g class="node node-proxy" transform="translate(320 140)">
			<rect x="-70" y="-36" width="140" height="72" rx="14" />
			<text class="node-label" y="-2">CLI Proxy</text>
			<text class="node-sub" y="20">one endpoint</text>
		</g>
		<g class="node account account-a" transform="translate(545 75)">
			<rect x="-75" y="-44" width="150" height="88" rx="12" />
			<text class="node-label" y="-14">Account A</text>
			<rect class="quota-track" x="-55" y="2" width="110" height="10" rx="5" />
			<rect class="quota-fill" x="-55" y="2" width="20" height="10" rx="5" />
			<text class="node-sub status" y="32">ok</text>
		</g>
		<g class="node account account-b" transform="translate(545 205)">
			<rect x="-75" y="-44" width="150" height="88" rx="12" />
			<text class="node-label" y="-14">Account B</text>
			<rect class="quota-track" x="-55" y="2" width="110" height="10" rx="5" />
			<rect class="quota-fill" x="-55" y="2" width="20" height="10" rx="5" />
			<text class="node-sub status" y="32">standby</text>
		</g>

		<line class="link" x1="146" y1="140" x2="250" y2="140" />
		<path class="link route-a" d="M390 140 L470 75" />
		<path class="link route-b" d="M390 140 L470 205" />

		<circle class="packet" r="6" cx="146" cy="140" />
	</svg>
	<figcaption>When Account A hits its limit, the proxy cools it down and sends the next request to Account B. Your tools never notice.</figcaption>
</figure>

<script>
	import { createTimeline } from 'animejs';

	if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
		document.querySelectorAll<SVGSVGElement>('.proxy-failover svg').forEach((svg) => {
			const $ = (s: string) => svg.querySelector(s)!;
			const packet = $('.packet');
			const send = (tl: ReturnType<typeof createTimeline>, toY: number) =>
				tl
					.add(packet, { cx: [146, 390], cy: [140, 140], opacity: [0, 1], duration: 700 })
					.add(packet, { cx: [390, 470], cy: [140, toY], opacity: [1, 0], duration: 500 });

			const tl = createTimeline({ loop: true, loopDelay: 600, defaults: { ease: 'inOutQuad' } });
			for (const w of [50, 80]) {
				send(tl, 75);
				tl.add($('.account-a .quota-fill'), { width: w, duration: 300 });
			}
			send(tl, 75);
			tl.add($('.account-a .quota-fill'), { width: 110, duration: 300 })
				.add($('.account-a'), { opacity: [1, 0.45], duration: 300 })
				.add($('.account-a .status'), { opacity: [1, 0, 1], duration: 300, onBegin: () => ($('.account-a .status').textContent = 'limit hit · cooling down') }, '<<')
				.add($('.account-b .status'), { opacity: [1, 0, 1], duration: 300, onBegin: () => ($('.account-b .status').textContent = 'serving') });
			for (const w of [40, 60]) {
				send(tl, 205);
				tl.add($('.account-b .quota-fill'), { width: w, duration: 300 });
			}
			tl.add([$('.account-a .quota-fill'), $('.account-b .quota-fill')], {
				width: 20,
				duration: 400,
				delay: 800,
				onComplete: () => {
					$('.account-a .status').textContent = 'ok';
					$('.account-b .status').textContent = 'standby';
				},
			}).add($('.account-a'), { opacity: 1, duration: 300 }, '<<');
		});
	}
</script>

---
// A task leaves the laptop, the VPS works on it, the result lands on the phone. All inside the tailnet.
---

<figure class="guide-figure fleet-map">
	<svg viewBox="0 0 640 300" role="img" aria-label="A laptop sends a task to a VPS, and the result arrives on a phone, all inside a private Tailscale network">
		<rect class="tailnet" x="20" y="20" width="600" height="260" rx="20" />
		<text class="tailnet-label" x="40" y="48">your tailnet (private)</text>

		<path class="link" id="fm-in" d="M178 168 C 225 168, 238 150, 262 150" />
		<path class="link" id="fm-out" d="M378 150 C 402 150, 415 168, 462 168" />

		<g class="device" transform="translate(120 160)">
			<rect x="-34" y="-30" width="68" height="44" rx="4" />
			<path d="M-46 20 H46 L40 28 H-40 Z" />
			<text class="node-label" y="58">Laptop</text>
		</g>

		<g class="device device-vps" transform="translate(320 150)">
			<circle class="halo" r="62" />
			<rect x="-32" y="-36" width="64" height="20" rx="4" />
			<rect x="-32" y="-10" width="64" height="20" rx="4" />
			<rect x="-32" y="16" width="64" height="20" rx="4" />
			<circle class="led" cx="-20" cy="-26" r="2.5" />
			<circle class="led" cx="-20" cy="0" r="2.5" />
			<circle class="led" cx="-20" cy="26" r="2.5" />
			<text class="node-label" y="88">VPS</text>
			<text class="node-sub" y="106">T3 server, agents, CLIs</text>
		</g>

		<g class="device" transform="translate(520 160)">
			<rect x="-18" y="-34" width="36" height="66" rx="7" />
			<path d="M-6 24 H6" />
			<text class="node-label" y="58">Phone</text>
		</g>

		<circle class="packet packet-in" r="5" />
		<circle class="packet packet-out" r="5" />
	</svg>
	<figcaption>Start a task from your laptop. The VPS does the work. Check the result from your phone.</figcaption>
</figure>

<script>
	import { createTimeline, svg } from 'animejs';

	if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
		document.querySelectorAll<SVGSVGElement>('.fleet-map svg').forEach((el) => {
			const $ = (s: string) => el.querySelector(s)!;
			createTimeline({ loop: true, loopDelay: 900 })
				.add($('.packet-in'), { ...svg.createMotionPath($('#fm-in') as SVGPathElement), opacity: [0, 1, 1, 0], duration: 1100, ease: 'inOutSine' })
				.add($('.halo'), { scale: [1, 1.12, 1], opacity: [0.5, 1, 0.5], duration: 900, ease: 'inOutSine' })
				.add(el.querySelectorAll('.led'), { opacity: [1, 0.2, 1], duration: 300, delay: (_, i) => i * 120 }, '<<')
				.add($('.packet-out'), { ...svg.createMotionPath($('#fm-out') as SVGPathElement), opacity: [0, 1, 1, 0], duration: 1100, ease: 'inOutSine' });
		});
	}
</script>

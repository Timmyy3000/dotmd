---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getPublishedPosts } from '../lib/posts';

const posts = await getPublishedPosts();
---

<BaseLayout title="dotmd" description="Chasing the impro" canonicalPath="/">
	<section class="intro-panel intro-panel-home">
		<p class="eyebrow">A personal blog by Timi</p>
		<h1>Thinking in public.</h1>
		<p class="home-description">Essays about AI agents, building companies, and the strange work of trying to make useful things exist.</p>
		<p class="vibe-disclaimer">Written by <a href="https://x.com/timithechef" target="_blank" rel="noreferrer">Timi</a> · built by agents</p>
	</section>

	<section class="feed" aria-label="Post feed">
		{
			posts.length === 0 ? (
				<p>Nothing here yet — the first post is on its way.</p>
			) : (
				posts.map((post) => <PostCard post={post} />)
			)
		}
	</section>
</BaseLayout>

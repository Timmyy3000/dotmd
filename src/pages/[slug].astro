---
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate, getPublishedPosts, type PostEntry } from '../lib/posts';

export async function getStaticPaths() {
	const posts = await getPublishedPosts();

	return posts.map((post) => ({
		params: { slug: post.slug },
		props: { post },
	}));
}

const { post } = Astro.props as { post: PostEntry };
const { Content } = await post.render();
const hasTwitterEmbed = post.body.includes('twitter-tweet');
const canonicalUrl = post.data.canonicalUrl ?? `/${post.slug}`;
---

<BaseLayout
	title={`${post.data.title} | dot md`}
	description={post.data.description}
	canonicalPath={canonicalUrl}
	image={post.data.coverImage ? (post.data.coverImage.startsWith('/') ? post.data.coverImage : `/${post.data.coverImage}`) : undefined}
>
	<article class="post-shell">
		<header class="post-header">
			<p class="post-meta">
				<time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
				{post.data.updated && <span>Updated {formatDate(post.data.updated)}</span>}
			</p>
			<h1>{post.data.title}</h1>
			<p class="post-dek">{post.data.description}</p>
			{post.data.tags.length > 0 && (
				<ul class="tag-list" aria-label="Tags">
					{post.data.tags.map((tag) => (
						<li>{tag}</li>
					))}
				</ul>
			)}
			<p class="reader-count" data-reader-count hidden aria-live="polite">
				<span data-reader-count-value>—</span> unique reader<span data-reader-count-plural>s</span>
			</p>
		</header>
		{post.data.coverImage && (
			<img
				class="post-cover"
				src={post.data.coverImage.startsWith('/') ? post.data.coverImage : `/${post.data.coverImage}`}
				alt={post.data.coverAlt ?? ''}
				loading="eager"
			/>
		)}
		<div class="post-content">
			<Content />
		</div>
		<script is:inline define:vars={{ articleSlug: post.slug }}>
			const readerCount = document.querySelector('[data-reader-count]');
			const readerCountValue = document.querySelector('[data-reader-count-value]');
			const readerCountPlural = document.querySelector('[data-reader-count-plural]');
			const controller = new AbortController();
			const timeout = window.setTimeout(() => controller.abort(), 2500);

			fetch('https://drain.timi.click/v1/article-views', {
				method: 'POST',
				mode: 'cors',
				credentials: 'omit',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ article: articleSlug }),
				signal: controller.signal,
			})
				.then((response) => (response.ok ? response.json() : Promise.reject(new Error('reader count unavailable'))))
				.then(({ count }) => {
					if (!readerCount || !readerCountValue || !Number.isFinite(count)) return;
					readerCountValue.textContent = count.toLocaleString();
					if (count === 1) readerCountPlural?.remove();
					readerCount.hidden = false;
				})
				.catch(() => {})
				.finally(() => window.clearTimeout(timeout));
		</script>
		{hasTwitterEmbed && <script is:inline async src="https://platform.twitter.com/widgets.js" charset="utf-8"></script>}
	</article>
</BaseLayout>
